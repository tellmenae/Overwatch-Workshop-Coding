rule("READ ME !!! - // REAPER REWORK // by tellmenae#2567")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		"Developer Comment:\r\nThe goal I had with this rework was to make Reaper much more fun to play - while also demanding a much higher skill floor and allowing for more skill expression - as well as lower his tankbuster playstyle capabilities and focus on a"
		Break;
		"flank-focused playstyle. I've had theses ideas for months and only now got to executing them. Guess I was too hopeful Blizzard was going to finally do it - them announcing the rework's cancellation was the nail in the coffin for me.\r"
		Break;
		"Literally my first ever workshop creation, so it's pretty scuffed. Had zero script experience beforehand except for watching a few ROBLOX tutorials :P"
		Break;
		"Hope you have fun with my rework :]. Add AI, play with friends, test it out and don't hesitate to give input. You can reach out to me on Discord (tellmenae)!"
		Break;
		"Changelog:"
		Break;
		"Reaper:\r\n- Health reduced from 300 to 225\r"
		Break;
		"Wraith Form:\r\n- Now on a Resource meter:\r\n  - The resource replenishes over time\r\n  - Deal damage to replenish\n  - Replenishes after using Shadow Step and Ultimate\n- Triggers flight\r\n- Cooldown reduced to 3 seconds\r\n- No longer reloads Hellfire Shotguns"
		Break;
		"Shadow Step:\r\n- Reloads Hellfire Shotguns\r\n- Replenishes Wraith Form\r"
		Break;
	}
}

rule("reload after E")
{
	event
	{
		Ongoing - Each Player;
		All;
		Reaper;
	}

	conditions
	{
		Is Using Ability 2(Event Player) == True;
	}

	actions
	{
		Wait(1.500, Abort When False);
		Set Ammo(Event Player, 0, 6);
		Wait(0.016, Ignore Condition);
		Play Effect(Event Player, Buff Impact Sound, Null, Position Of(Event Player), 100);
	}
}

