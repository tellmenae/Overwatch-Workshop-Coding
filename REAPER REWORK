rule("air movement")
{
	event
	{
		Ongoing - Each Player;
		All;
		Reaper;
	}

	conditions
	{
		Is Using Ability 1(Event Player) == True;
		Event Player.Flight == True;
		Throttle Of(Event Player) != Vector(0, 0, 0);
		disabled Is On Ground(Event Player) == False;
	}

	actions
	{
		Start Accelerating(Event Player, Vector(X Component Of(Throttle Of(Event Player)), Z Component Of(Throttle Of(Event Player))
			* Y Component Of(Local Vector Of(Facing Direction Of(Event Player), Event Player, Rotation)), Z Component Of(Throttle Of(
			Event Player)) * Z Component Of(Local Vector Of(Facing Direction Of(Event Player), Event Player, Rotation))), 10, 5, To Player,
			Direction Rate and Max Speed);
		Wait(0.010, Abort When False);
		Loop If Condition Is True;
		Else;
		Cancel Primary Action(Event Player);
	}
}

