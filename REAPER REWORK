rule("Wraith Increase")
{
	event
	{
		Player Dealt Damage;
		All;
		Reaper;
	}

	conditions
	{
		Is Using Ability 1(Event Player) == False;
		disabled Event Player.ReplenishWraith == True;
		Event Player.Wraith < 100;
	}

	actions
	{
		Stop Chasing Player Variable(Event Player, Wraith);
		Chase Player Variable At Rate(Event Player, Wraith, Event Player.Wraith + Event Damage / 13, 1000000000, Destination and Rate);
		Wait(0.016, Ignore Condition);
		Stop Chasing Player Variable(Event Player, Wraith);
		Wait(0.016, Ignore Condition);
		Chase Player Variable At Rate(Event Player, Wraith, 100, 4, Destination and Rate);
		If(Event Player.Wraith >= 100);
			Event Player.Wraith = 100;
	}
}

